{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {"url": "https://raw.githubusercontent.com/zitingmow/FIT3179-DV2/main/data/nma_collections.csv"},
    "width": "container",
    "height": 300,
    "params": [
        {
            "name": "Category_selection",
            "bind": {
                "input": "select",
                "options": [
                    null,
                    "Banknotes",
                    "Coins",
                    "Medals",
                    "Stamps",
                    "Tokens",
                    "Other"
                ],
            "labels": [
                    "Show All",
                    "Banknotes",
                    "Coins",
                    "Medals",
                    "Stamps",
                    "Tokens",
                    "Other"
                ],
                "name": "Cetegory Selection: "
            }
        },
        {
            "name": "Year_filter",
            "value": 0,
            "bind": {
                "input": "range",
                "min": 1750,
                "max": 2010,
                "step": 1,
                "name": "Year Selection: "
            }
        }
    ],
    "transform": [
        {"filter": "Category_selection == null || datum.category_group == Category_selection"},
        {"filter": "datum.year != null && datum.year > 1700"},
        {"filter": "datum.year > Year_filter"}
    ],
    "mark":{
        "type": "area",
        "interpolate":"basis",
        "color": "#FFFFFF"
    },
    "encoding": {
        "x": {
            "field" : "year",
            "type" : "quantitative",
            "title": "Year",
            "axis":{"format": "d"}
        },
        "y":{
            "aggregate" : "count",
            "type" : "quantitative",
            "stack" : "center",
            "title": "Number of Recorded Collectibles"
        },
        "color": {
            "field": "category_group",
            "type": "nominal",
            "title": "Category Group",
            "scale":{
                "domain": ["Banknotes", "Coins", "Medals", "Stamps", "Tokens", "Other"],
                "range": ["#D95CB5","#FF5C66","#BF5454","#FF8A54","#F5C2FF","#8B4E9E"]
            }
        }
    },
    "config":{
        "view": { "stroke": null},
        "axis": {
            "titleFont": "Plus Jakarta Sans", "titleFontSize": 11, "titlePadding": 10, 
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 11, "labelPadding": 5,
            "grid": false
        },
        "legend": {
            "orient": "right",
            "titleFont": "Plus Jakarta Sans", "titleFontSize": 10, "titleColor":"#0D2B80",
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 9, "labelColor":"#0D2B80",
            "symbolSize": 100
        }
    }
}
